# ─── Supabase (get these from your Supabase project → Settings → API) ───
# The Project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# The public "anon" key (the one labelled "anon / public"). Safe in the browser.
VITE_SUPABASE_ANON_KEY=

# NOTE: You do NOT need the service_role key for this app.
# NEVER put the service_role key in any VITE_* variable or in the browser —
# it bypasses all security. This app only ever uses the anon key.

# ─── Server ───
# Railway sets PORT automatically; only set this for local `npm start`.
# PORT=3000
