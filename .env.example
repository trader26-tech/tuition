# ─── Supabase (Settings → API) — used by the SERVER only ───
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# The service_role key. Server-side only — it is NEVER sent to the browser.
# (This app talks to the database from the Express server, not the frontend.)
SUPABASE_SERVICE_ROLE_KEY=

# ─── Session ───
# Secret used to sign login tokens. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Server ───
# Railway sets PORT automatically; only set this for local runs if needed.
# PORT=3000
